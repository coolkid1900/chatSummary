# ===== 复制为 .env 后填写真实值 =====

# ---- 聊天记录分表（分表键 from_user，路由=Java hashCode）----
SHARD_COUNT=20
SHARD_TABLE_PREFIX=user_chat_record_sharding_
# 微信客户(外部联系人)external_userid 前缀（企微：wm/wo，机器人 wb）；from_user 以此开头=客户
EXTERNAL_ID_PREFIXES=wm,wo

# ---- MySQL 8 ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=chat
MYSQL_PASSWORD=chatpass
MYSQL_DATABASE=chat_summary

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- SiliconFlow bge-m3 (Embedding, OpenAI 兼容) ----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64
# 单条输入字符数上限（正整数），超长保留开头；字符数不等于 token 数
EMBEDDING_MAX_INPUT_CHARS=7500
# 每秒限流 m 次（embedding 是主要瓶颈，m 较低）
EMBEDDING_RATE_PER_SEC=4
# 单 pod 内并发请求数：受令牌桶约束，用于打满 m/s（请求有往返延迟时收益明显）
EMBEDDING_CONCURRENCY=8

# ---- DeepSeek V4 Flash (意图概括, OpenAI 兼容) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
# 每秒限流 n 次
LLM_RATE_PER_SEC=8
# 意图概括并发数：受 LLM 令牌桶约束打满 n/s（主题数多时显著缩短端到端时间）
LLM_CONCURRENCY=8

# ---- 聚类后端切换（§6.0，不得硬编码）----
# umap_hdbscan = UMAP + HDBSCAN（大内存/GPU）；incremental = IncrementalPCA + MiniBatchKMeans（2G pod 流式，默认）
CLUSTER_BACKEND=incremental
N_COMPONENTS=10
N_CLUSTERS=50
MIN_CLUSTER_SIZE=100
USE_GPU=false

# ---- 向量存储后端（§9）----
# local = 本地分片 parquet（docker-compose 默认）；s3 = S3 兼容对象存储（K8s 推荐）
VECTOR_STORE_BACKEND=local
VECTOR_STORE_DIR=/app/data/embeddings
VECTOR_TTL_DAYS=7
# s3 后端专用
S3_ENDPOINT=
S3_BUCKET=chat-embeddings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---- 业务参数 ----
TOP_N=20                  # 输出 TOP N 热点
RANK_BREADTH_WEIGHT=0.3   # 热度排序客户广度权重：分=heat×customer_count^w（0=纯按消息数）
SESSION_GAP_MINUTES=30    # 会话聚合时间窗
MIN_TEXT_LEN=5            # 规则过滤：短于此长度丢弃
DEDUP_CACHE_TTL=604800    # 文本去重缓存 TTL（秒），默认 7 天
NR_DOCS=8                 # 送 LLM 的代表原文条数（§10.4 调大到 8~10，MMR 选样）
NR_REPR_DOCS=5            # 落库保留的代表原文条数

# ---- 流式/分片与性能 ----
SHARD_SIZE=2048           # 每个 parquet 分片的会话数（也是 embedding 累积窗口）
CLUSTER_BATCH_SIZE=2048   # 聚类分批读取大小
JIEBA_WORKERS=4           # jieba 预分词多进程数（CPU 大户，§5 步骤7）
EMBED_CACHE_MAX_LEN=24    # 只把短文本（高频话术）放 Redis 缓存（§9 小热数据）
REPR_POOL_SIZE=40         # 每主题代表文档蓄水池上限（送 LLM 前 MMR 选样）
TOPIC_MERGE_SIM=0.85      # 主题质心余弦≥此值合并近重复簇（消除碎片化重复热点）；0 关闭

# ---- 趋势/突增（环比昨日）----
TREND_MATCH_SIM=0.3       # 与昨日主题的热词 Jaccard≥此值视为同一主题
SURGE_PCT=0.5             # 环比涨幅≥此值（+50%）判为突增
SURGE_MIN_HEAT=20         # 突增的最小热度门槛，过滤长尾噪声

# ---- worker 标识（多 worker 并发写分片用，K8s 注入 pod 名）----
WORKER_ID=local

# ---- HTTP 触发批处理鉴权（为空=不校验；设置后需在请求头 X-Trigger-Token 带上）----
TRIGGER_TOKEN=
